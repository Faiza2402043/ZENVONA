# Browser-safe Supabase settings. The publishable/anon key is designed for public clients;
# RLS must be enabled and correct. Never put a service-role or secret key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Set these as Supabase Edge Function secrets, not browser variables.
AI_API_KEY=configure-as-edge-function-secret
AI_MODEL=gpt-4o-mini
LIVEKIT_URL=configure-when-live-provider-is-selected

# Stripe test-mode values: only the webhook and checkout Edge Functions may read secrets.
STRIPE_SECRET_KEY=configure-as-edge-function-secret
STRIPE_WEBHOOK_SECRET=configure-as-edge-function-secret
SUPABASE_SERVICE_ROLE_KEY=configure-as-edge-function-secret
PUBLIC_APP_URL=https://your-deployed-app.example